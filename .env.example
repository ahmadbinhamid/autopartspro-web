# URL the header/nav "Log in" button sends visitors to.
# Baked in at build time by Vite — see Dockerfile ARG/ENV VITE_LOGIN_URL
# and docker-compose.yml build.args.
VITE_LOGIN_URL=YOUR_DOMAIN_HERE

# Dashboard API base URL — the "Request a demo" form posts here (POST
# {VITE_API_URL}/demo-request), the same backend pha-dashboard's own
# frontend and pha-storefront talk to. Defaults to the local dev backend
# when unset (see src/lib/api.ts).
VITE_API_URL=http://localhost:7001/api/v1
